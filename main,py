class Account:
    def __init__(self, owner, acc_no, balance):
        self.owner = owner
        self.acc_no = acc_no
        self.balance = balance
        
def deposit(self, amount):
        if amount <= 0:
            print("Invalid amount!")
        else:
            self.balance = self.balance + amount
            print(amount, "deposited. New balance:", self.balance)
   